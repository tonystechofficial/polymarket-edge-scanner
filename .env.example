# Copy to `.dev.vars` in apps/worker for local development (never commit either file).
# Only ONE secret exists in this project. There is no wallet key by design: the build is simulation-only.

# Bearer token protecting /api/admin/* routes. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Used only by scripts/smoke-prod.mjs (the deployed Worker URL, no trailing slash).
BASE_URL=
